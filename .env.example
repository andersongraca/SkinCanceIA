# Copie para .env.local e preencha somente no ambiente local.
# Nunca versione .env, .env.local ou credenciais reais.

PORT=3000
DATABASE_URL=mysql://usuario:senha@localhost:3306/skincancer
OAUTH_SERVER_URL=https://seu-servidor-oauth.example
JWT_SECRET=gere-um-segredo-local

ML_PROJECT_ROOT=/caminho/absoluto/SkinCancerCADDermoIA
ML_PYTHON_PATH=/usr/bin/python3
ML_CNN_CHECKPOINT=/caminho/absoluto/SkinCancerCADDermoIA/ml_artifacts/ham10000/cnn/best.pt
ML_VIT_CHECKPOINT=/caminho/absoluto/SkinCancerCADDermoIA/ml_artifacts/ham10000/vit/best.pt
ML_HYBRID_CHECKPOINT=/caminho/absoluto/SkinCancerCADDermoIA/ml_artifacts/ham10000/hybrid/best.pt
ML_DOMAIN_REFERENCE=/caminho/absoluto/SkinCancerCADDermoIA/ml_artifacts/ham10000/quality_reference.json
ML_ENSEMBLE_WEIGHTS_PATH=/caminho/absoluto/SkinCancerCADDermoIA/ml_artifacts/ham10000/ensemble/weights.json
ML_MODEL_VERSION=ham10000-160px-epoch2
ML_INFERENCE_TIMEOUT_MS=600000

# Obrigatório em produção para upload e persistência de heatmaps.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
